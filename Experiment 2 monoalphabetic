import java.util.Scanner;
public class Exp2{
    public static void main(String[] args){
        Scanner input=new Scanner(System.in);
        String plainalpha="ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        String cipheralpha="QWERTYUIOPASDFGHJKLZXCVBNM";
        System.out.println("Enter the Plain Text :");
        String plaintext=input.nextLine().toUpperCase();
        String encypt="";
        for(int i=0;i<plaintext.length();i++){
            char ch=plaintext.charAt(i);
            int index = plainalpha.indexOf(ch);
            if(index!=-1){
                encypt=encypt+cipheralpha.charAt(index);
            }else{
                encypt=encypt+ch;
            }
        }
        System.out.println("Encrypted Text : "+encypt);
        String decrypt="";
        for(int i=0;i<encypt.length();i++){
            char ch= encypt.charAt(i);
            int index=cipheralpha.indexOf(ch);
            if (index!=-1){
                decrypt=decrypt+plainalpha.charAt(index);
            }else{
                decrypt=decrypt+ch;
            }
        }
        System.out.println("Decrypted Text : "+decrypt);
        input.close();
    }
}
